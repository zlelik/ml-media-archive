<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ml-media-archive</groupId>
  <artifactId>ml-media-archive</artifactId>
  <version>2.0.17</version>

  <properties>
    <java.version>25</java.version>
  </properties>


  <dependencies>
    <dependency>
      <groupId>com.codeborne</groupId>
      <artifactId>selenide</artifactId>
      <version>7.7.3</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
      <version>5.12.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <version>2.0.17</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.17</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
    
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.15.0</version>
        <configuration>
          <release>${java.version}</release>
        </configuration>
      </plugin>

      <plugin>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>copy-static-files</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}</outputDirectory>
              <resources>
                <resource>
                  <directory>src/main/webapp</directory>
                  <includes>
                    <include>**/*.html</include>
                    <include>**/indexer.js</include>
                    <include>**/indexer.css</include>
                    <include>**/archive-search.html</include>
                    <include>**/archive-search.css</include>
                    <include>**/archive-search.js</include>
                    <include>**/loading.png</include>
                    <include>**/ag-grid-community.min-33.2.2.js</include>
                    <include>**/z_cities1000_sorted_by_lon_lat.js</include>
                    <include>**/z_cities1000_sorted_by_lon_lat_1.js</include>
                    <include>**/z_cities1000_sorted_by_lon_lat_2.js</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>run-buildmerger</id>
            <phase>process-test-classes</phase>
            <goals>
              <goal>java</goal>
            </goals>
            <configuration>
              <mainClass>app.ml.media.archive.Builder</mainClass>
              <arguments>
                <argument>${project.build.directory}</argument>
                <argument>${project.version}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- JaCoCo Test Coverage -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.14</version>
  
        <executions>
  
          <!-- Attach agent for test execution -->
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
  
          <!-- Generate report -->
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
  
          <!-- Coverage enforcement (80%) -->
          <!-- REPORT-ONLY MODE: comment whole execution block -->
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
  
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.80</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>

        </executions>
      </plugin>
  
  
      <!-- PMD (code quality) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>3.28.0</version>
  
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
  
        <configuration>
          <failOnViolation>true</failOnViolation>
          <!-- REPORT-ONLY MODE-->
          <!--<failOnViolation>false</failOnViolation>-->
          <printFailingErrors>true</printFailingErrors>
        </configuration>
      </plugin>
  
      <!-- SpotBugs (bug detection) -->
      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <version>4.9.8.3</version>
  
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
  
        <configuration>
          <effort>Max</effort>
          <threshold>High</threshold>
          <failOnError>true</failOnError>
            <!-- REPORT-ONLY MODE -->
            <!--<failOnError>false</failOnError>-->
          <xmlOutput>true</xmlOutput>
        </configuration>
      </plugin>
    
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.0.0</version>
        <executions>
          <execution>
            <id>cleanup-target-folder</id>
            <phase>verify</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>

                <echo level="info">Build offline release [verify phase]</echo>

                <zip destfile="${project.basedir}/releases/release_${project.version}.zip">
                  <fileset dir="${project.build.directory}">
                    <include name="index.html" />
                    <include name="indexer.js" />
                    <include name="indexer.css" />
                    <include name="z_cities1000_sorted_by_lon_lat_1.js" />
                    <include name="z_cities1000_sorted_by_lon_lat_2.js" />
                    <include name="loading.png" />
                  </fileset>
                </zip>

                <echo level="info">Delete unnecessary files [verify phase]</echo>

                <delete includeEmptyDirs="true">
                  <fileset dir="${project.build.directory}" defaultExcludes="no">
                    <include name="**/*" />
                    <exclude name="index.html" />
                    <exclude name="indexer.js" />
                    <exclude name="indexer.css" />
                    <exclude name="z_cities1000_sorted_by_lon_lat.js" />
                    <exclude name="z_cities1000_sorted_by_lon_lat_1.js" />
                    <exclude name="z_cities1000_sorted_by_lon_lat_2.js" />
                    <exclude name="loading.png" />
                  </fileset>
                </delete>

              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

    </plugins>
  </build>
</project>
